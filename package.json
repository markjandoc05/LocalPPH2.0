{
  "name": "applet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "SKIP_DB_DURING_BUILD=true next build && mkdir -p .next/standalone/public && cp -r public/. .next/standalone/public/ 2>/dev/null || true && mkdir -p .next/standalone/.next/static && cp -r .next/static/. .next/standalone/.next/static/ 2>/dev/null || true",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:seed": "tsx src/db/seed.ts",
    "db:import": "tsx src/db/import.ts",
    "db:dev:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:dev:seed": "tsx src/db/seed.ts",
    "db:dev:import": "tsx src/db/import.ts",
    "db:prod:migrate": "echo 'WARNING: Are you sure you want to run migrations against PRODUCTION? (y/n)' && read -r ans && [ \"$ans\" = 'y' ] && NODE_ENV=production drizzle-kit migrate --config=src/db/drizzle.config.ts || echo 'Aborted.'"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5"
  }
}
