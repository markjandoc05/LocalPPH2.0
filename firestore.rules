rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definitions
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Admin check - only if the app has an admin feature
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 255 &&
             data.role in ['ADMIN', 'BUSINESS', 'SUBSCRIBER'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    // 4. Fortress Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list users
      
      allow create: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidId(userId) && 
                    isValidUser(incoming()) &&
                    incoming().role == 'SUBSCRIBER' && // Default role
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidUser(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt &&
                    (
                      // Action: Update Profile
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt'])
                    ) || isAdmin();
    }
    
    // Admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
    
    // Connection test collection
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
