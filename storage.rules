rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public media (logo, cover, gallery images, documents)
    match /businesses/{businessId}/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && category in ['logo', 'cover', 'gallery', 'documents']
                    && request.resource.size <= (category == 'documents' ? 10 * 1024 * 1024 : 1 * 1024 * 1024)
                    && (
                      request.resource.contentType.matches('image/.*')
                      || (category == 'documents' && request.resource.contentType == 'application/pdf')
                    );
    }
  }
}
